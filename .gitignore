# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# uv
# NOTE: uv.lock is intentionally excluded from this challenge repo.

# Env / secrets — never commit these
.env
.env.*
*.pem
*.key
secrets.*
.databricks/

# Deploy config (databricks.yml / app.yaml) IS tracked in this repo: the PPCS
# app is deployed from here via a Databricks Git folder. Only the placeholder
# templates under service/ are committed (env values are REPLACE_WITH_*); never
# commit a copy with real schema/warehouse/Lakebase values filled in.
databricks.yml
app.yaml
!service/databricks.yml
!service/app.yaml

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Local proof / evidence scratch (submit via the scoreboard flow instead)
proof-scratch/
*.local.json
